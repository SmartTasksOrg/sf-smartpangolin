{
  "name": "smartpangolin-vscode",
  "displayName": "SmartPangolin (IAIso)",
  "version": "3.0.0",
  "description": "Scan a project tree for secrets in paths and content before sharing it with an LLM or third party.",
  "publisher": "smarttasks",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:smartpangolin.run"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartpangolin.run",
        "title": "SmartPangolin: Run on current file/workspace"
      }
    ],
    "configuration": {
      "title": "SmartPangolin",
      "properties": {
        "smartpangolin.python": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter"
        }
      }
    }
  }
}