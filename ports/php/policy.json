{
  "policy_version": "2026-08-01.1",
  "path_rules": [
    {
      "id": "SEC-PATH-ENV",
      "globs": [
        ".env",
        ".env.*",
        "*.env"
      ],
      "desc": "dotenv file (credential store)"
    },
    {
      "id": "SEC-PATH-PEM",
      "globs": [
        "*.pem",
        "*.key",
        "*.p8",
        "*.pkcs8",
        "*.pkcs12"
      ],
      "desc": "private key material"
    },
    {
      "id": "SEC-PATH-PFX",
      "globs": [
        "*.pfx",
        "*.p12",
        "*.jks",
        "*.keystore",
        "*.bks"
      ],
      "desc": "certificate/key store"
    },
    {
      "id": "SEC-PATH-SSH",
      "globs": [
        "id_rsa",
        "id_dsa",
        "id_ecdsa",
        "id_ed25519",
        "*.ppk",
        "authorized_keys",
        "known_hosts"
      ],
      "desc": "SSH key material"
    },
    {
      "id": "SEC-PATH-NETRC",
      "globs": [
        ".netrc",
        "_netrc",
        ".git-credentials",
        ".pypirc",
        ".npmrc",
        ".dockercfg"
      ],
      "desc": "credential helper file"
    },
    {
      "id": "SEC-PATH-CLOUD",
      "globs": [
        "credentials",
        "credentials.json",
        "client_secret*.json",
        "service-account*.json",
        "gcloud-*.json",
        "*serviceaccount*.json",
        "azureauth.json"
      ],
      "desc": "cloud service-account credential"
    },
    {
      "id": "SEC-PATH-KUBE",
      "globs": [
        "kubeconfig",
        "*.kubeconfig",
        "admin.conf"
      ],
      "desc": "kubeconfig (cluster credential)"
    },
    {
      "id": "SEC-PATH-VAULT",
      "globs": [
        "*.kdbx",
        "*.kdb",
        "*.opvault",
        "*.agilekeychain",
        ".vault-token",
        "*.gpg",
        "secring.*"
      ],
      "desc": "password vault / keyring"
    },
    {
      "id": "SEC-PATH-TFSTATE",
      "globs": [
        "*.tfstate",
        "*.tfstate.backup",
        "*.tfvars"
      ],
      "desc": "terraform state/vars (contains resolved secrets)"
    },
    {
      "id": "SEC-PATH-HISTORY",
      "globs": [
        ".bash_history",
        ".zsh_history",
        ".psql_history",
        ".mysql_history",
        ".python_history",
        "ConsoleHost_history.txt"
      ],
      "desc": "shell history (frequently contains pasted tokens)"
    },
    {
      "id": "SEC-PATH-DBDUMP",
      "globs": [
        "*.sql",
        "*.dump",
        "*.sqlite",
        "*.sqlite3",
        "*.db"
      ],
      "desc": "database dump/file (unvetted payload)"
    }
  ],
  "dir_rules": [
    {
      "id": "SEC-DIR-SECRET",
      "names": [
        ".secret",
        ".secrets"
      ],
      "desc": "enforced secret directory (SmartPangolin standard) \u2014 never shipped in any mode"
    },
    {
      "id": "SEC-DIR-SSH",
      "names": [
        ".aws",
        ".azure",
        ".docker",
        ".gnupg",
        ".kube",
        ".ssh"
      ],
      "desc": "credential directory"
    },
    {
      "id": "SEC-DIR-VCS",
      "names": [
        ".git",
        ".hg",
        ".svn"
      ],
      "desc": "VCS metadata (packed refs and remotes may embed tokens)"
    },
    {
      "id": "OPS-DIR-BUILD",
      "names": [
        ".mypy_cache",
        ".next",
        ".pytest_cache",
        ".terraform",
        ".tox",
        ".venv",
        "__pycache__",
        "build",
        "dist",
        "env",
        "ft-venv",
        "node_modules",
        "site-packages",
        "venv"
      ],
      "desc": "build/vendor directory"
    }
  ],
  "content_rules": [
    {
      "id": "SEC-CONT-HF",
      "regex": "\\bhf_[A-Za-z0-9]{34}\\b",
      "desc": "HuggingFace access token"
    },
    {
      "id": "SEC-CONT-AWSKEY",
      "regex": "\\b(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b",
      "desc": "AWS access key ID"
    },
    {
      "id": "SEC-CONT-AWSSEC",
      "regex": "(?i)aws_secret_access_key\\s*[=:]\\s*[\\\"']?[A-Za-z0-9/+=]{40}",
      "desc": "AWS secret access key"
    },
    {
      "id": "SEC-CONT-GHPAT",
      "regex": "\\bgh[pousr]_[A-Za-z0-9]{36}\\b",
      "desc": "GitHub personal access token"
    },
    {
      "id": "SEC-CONT-GHFINE",
      "regex": "\\bgithub_pat_[A-Za-z0-9_]{60,}\\b",
      "desc": "GitHub fine-grained PAT"
    },
    {
      "id": "SEC-CONT-GITLAB",
      "regex": "\\bglpat-[A-Za-z0-9_\\-]{20}\\b",
      "desc": "GitLab personal access token"
    },
    {
      "id": "SEC-CONT-ANTHROPIC",
      "regex": "\\bsk-ant-[A-Za-z0-9_\\-]{24,}\\b",
      "desc": "Anthropic API key"
    },
    {
      "id": "SEC-CONT-OPENAI",
      "regex": "\\bsk-(?!ant-)(?:proj-)?[A-Za-z0-9_\\-]{32,}\\b",
      "desc": "OpenAI API key"
    },
    {
      "id": "SEC-CONT-SLACK",
      "regex": "\\bxox[baprse]-[A-Za-z0-9\\-]{10,}\\b",
      "desc": "Slack token"
    },
    {
      "id": "SEC-CONT-GOOGLE",
      "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
      "desc": "Google API key"
    },
    {
      "id": "SEC-CONT-STRIPE",
      "regex": "\\b[rs]k_(?:live|test)_[A-Za-z0-9]{24,}\\b",
      "desc": "Stripe secret key"
    },
    {
      "id": "SEC-CONT-NPM",
      "regex": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "desc": "npm access token"
    },
    {
      "id": "SEC-CONT-PYPI",
      "regex": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_\\-]{50,}\\b",
      "desc": "PyPI upload token"
    },
    {
      "id": "SEC-CONT-TELEGRAM",
      "regex": "\\b\\d{8,10}:AA[A-Za-z0-9_\\-]{33}\\b",
      "desc": "Telegram bot token"
    },
    {
      "id": "SEC-CONT-SENDGRID",
      "regex": "\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b",
      "desc": "SendGrid API key"
    },
    {
      "id": "SEC-CONT-PEM",
      "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----",
      "desc": "inline PEM private key"
    },
    {
      "id": "SEC-CONT-PUTTY",
      "regex": "PuTTY-User-Key-File-\\d",
      "desc": "inline PuTTY private key"
    },
    {
      "id": "SEC-CONT-JWT",
      "regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}\\b",
      "desc": "JWT (may be a live bearer token)"
    },
    {
      "id": "SEC-CONT-DOCKERAUTH",
      "regex": "\\\"auths\\\"\\s*:\\s*\\{",
      "desc": "docker registry auth block"
    },
    {
      "id": "SEC-CONT-CONNSTR",
      "regex": "(?i)\\b(?:postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|amqp|mssql)://[^\\s:@/\\\"']+:[^\\s:@/\\\"']+@",
      "desc": "connection string with inline password"
    },
    {
      "id": "SEC-CONT-ASSIGN",
      "regex": "(?i)\\b(?:api[_\\-]?key|secret[_\\-]?key|access[_\\-]?token|auth[_\\-]?token|client[_\\-]?secret|private[_\\-]?key|passwd|password|bearer[_\\-]?token)\\b\\s*[:=]\\s*[\\\"'][^\\\"'\\n]{8,}[\\\"']",
      "desc": "secret-named variable assigned a literal value"
    }
  ],
  "local_rules": [
    {
      "id": "LOC-RFC1918",
      "regex": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})\\b",
      "desc": "private (RFC1918) IP address"
    },
    {
      "id": "LOC-CGNAT",
      "regex": "\\b100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.\\d{1,3}\\.\\d{1,3}\\b",
      "desc": "CGNAT/tailnet IP address"
    },
    {
      "id": "LOC-IPV6ULA",
      "regex": "\\bfd[0-9a-f]{2}:(?:[0-9a-f]{0,4}:){1,6}[0-9a-f]{0,4}\\b",
      "desc": "IPv6 unique-local address"
    },
    {
      "id": "LOC-UNC",
      "regex": "\\\\\\\\[A-Za-z0-9][A-Za-z0-9._\\-]{1,62}\\\\",
      "desc": "UNC network share path"
    },
    {
      "id": "LOC-WINUSER",
      "regex": "[A-Za-z]:\\\\Users\\\\[^\\\\\\s\\\"'<>|]+",
      "desc": "Windows user profile path"
    },
    {
      "id": "LOC-NIXUSER",
      "regex": "/(?:home|Users)/(?!runner\\b|user\\b|ubuntu\\b)[A-Za-z0-9._\\-]+/",
      "desc": "POSIX home directory with username"
    },
    {
      "id": "LOC-INTHOST",
      "regex": "\\b[a-z0-9][a-z0-9\\-]{0,62}\\.(?:local|lan|internal|intranet|corp|home|arpa)\\b",
      "desc": "internal hostname"
    },
    {
      "id": "LOC-MAC",
      "regex": "\\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\\b",
      "desc": "MAC address"
    },
    {
      "id": "LOC-SSHCFG",
      "regex": "(?m)^\\s*HostName\\s+\\S+",
      "desc": "SSH client host configuration"
    }
  ],
  "path_allowlist": [
    ".env.example",
    ".env.sample",
    ".env.template",
    "env.example"
  ],
  "source_extensions": [
    ".bash",
    ".c",
    ".cjs",
    ".conf",
    ".config",
    ".cpp",
    ".css",
    ".gitignore",
    ".go",
    ".h",
    ".hpp",
    ".htm",
    ".html",
    ".ini",
    ".java",
    ".js",
    ".json",
    ".jsx",
    ".md",
    ".mjs",
    ".mod",
    ".php",
    ".py",
    ".rb",
    ".rs",
    ".rst",
    ".sass",
    ".scss",
    ".sh",
    ".sql",
    ".tf",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".xml",
    ".xsl",
    ".xslt",
    ".yaml",
    ".yml",
    ".zsh"
  ],
  "source_extensionless": [
    "cmakelists.txt",
    "docker-compose.yml",
    "dockerfile",
    "makefile"
  ],
  "pii_rules": [
    {
      "id": "PII-EMAIL",
      "regex": "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b",
      "token": "[EMAIL]"
    },
    {
      "id": "PII-SSN",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "token": "[SSN]"
    },
    {
      "id": "PII-CC",
      "regex": "\\b\\d(?:[ \\-]?\\d){14,15}\\b",
      "token": "[CARD]"
    },
    {
      "id": "PII-PHONE",
      "regex": "\\b(?:\\+?\\d{1,3}[ .\\-]?)?(?:\\(\\d{3}\\)|\\d{3})[ .\\-]?\\d{3}[ .\\-]?\\d{4}\\b",
      "token": "[PHONE]"
    }
  ],
  "pii_author_regex": "(?i)(?:^|[^a-z])(authors?|maintainer|maintained by|copyright|\\(c\\)|\u00a9|@author)"
}
