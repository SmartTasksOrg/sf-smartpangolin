__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# NOTE: this project ships a real `build/` content folder (build-all scripts) and
# builds with hatchling (output goes to dist/), so we do NOT ignore build/.
dist/
.venv/
venv/
ft-venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# SmartPangolin's own generated artifacts live one level up, but ignore them if run in-tree:
extracted_source/
share_archive/
file_folder_tree.txt
file_folder_path.txt
# Never commit real secrets:
.env
.secret/
!.secret/.gitignore
# ...except the intentional demo fixture that the scanner demo relies on:
!demo/repo/.env
